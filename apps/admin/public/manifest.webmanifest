      "purpose": "any",
      "type": "image/png",
      "sizes": "192x192",
      "src": "/icons/waritrack-3d-192.png?v=3"
    },
    {
      "purpose": "any",
      "type": "image/png",
      "sizes": "512x512",
      "src": "/icons/waritrack-3d-512.png?v=3"
    },
    {
      "purpose": "maskable",
      "type": "image/png",
      "sizes": "192x192",
      "src": "/icons/waritrack-3d-maskable-192.png?v=3"
    },
    {
      "purpose": "maskable",
      "type": "image/png",
      "sizes": "512x512",
      "src": "/icons/waritrack-3d-maskable-512.png?v=3"
    }
  ]
}
