# Copier en .env.local et remplir avec les valeurs de Firebase Console
# → Paramètres du projet → Vos applications → Web (config "Web app", PAS
# le service account JSON utilisé par le script Python de sync).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Console → Paramètres du projet → Cloud Messaging → onglet
# "Certificats push web" → générer une paire de clés
VITE_FIREBASE_VAPID_KEY=
