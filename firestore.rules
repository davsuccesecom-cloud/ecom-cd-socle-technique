rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model (Multi-tenant SaaS COD E-commerce — WariTrack)
    // ===============================================================
    //
    // Auth & Custom Claims:
    //   - claims.workspaceId: string (required for all tenant access)
    //   - claims.role: 'admin' | 'closeuse' | 'livreur'
    //   - claims.teamId: string (required for closeuse & livreur)
    //
    // Collection: /adminsByEmail/{email}
    //   - Server-only Google email -> { workspaceId, uid, createdAt }
    //
    // Collection: /workspaces/{workspaceId}
    //   - Workspace config (id, name, ownerEmail, createdAt, branding)
    //   - Subcollections:
    //     - /teams/{teamId} (team config, /secrets/{secretId}, /dailyStats/{dateKey})
    //     - /users/{userId} (role, teamId, status, fcmTokens <= 20, fcmUpdatedAt int, reminderWindowStart/End)
    //     - /accessLinks/{linkId}, /accessLinkSecrets/{linkId}, /trackingSessions/{sessionId} (server-only)
    //     - /notifications/{notifId} (admin or recipient userId; client update 'read' only)
    //     - /remunerations/{userId} (read admin or owner; server-written)
    //     - /codInsights/{countryCode} (read admin only; server-written via Admin SDK)
    //     - /orders/{orderId} (team-scoped orders; role-separated status & note updates)
    //     - /shopifyConnections/{id}, /shopifyUnroutedOrders/{id}, /aiAssistantChats/{id},
    //       /cashSettlements/{id}, /metaOAuthSessions/{id} (admin-only)
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function auth_() { return request.auth; }
    function claims() { return auth_().token; }
    function isSignedIn() { return auth_() != null; }
    function isOwner(userId) { return isSignedIn() && auth_().uid == userId; }
    function isWorkspace(workspaceId) {
      return isSignedIn()
        && 'workspaceId' in claims()
        && claims().workspaceId == workspaceId;
    }
    function isAdmin(workspaceId) {
      return isWorkspace(workspaceId)
        && 'role' in claims()
        && claims().role == 'admin';
    }
    function isCloseuse(workspaceId) {
      return isWorkspace(workspaceId)
        && 'role' in claims()
        && claims().role == 'closeuse';
    }
    function isLivreur(workspaceId) {
      return isWorkspace(workspaceId)
        && 'role' in claims()
        && claims().role == 'livreur';
    }
    function isSameTeam(teamId) {
      return 'teamId' in claims() && claims().teamId == teamId;
    }

    function isValidOptionalNullableString(dataMap, field, maxLen) {
      return !(field in dataMap)
        || dataMap[field] == null
        || (dataMap[field] is string && dataMap[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Validation de mise à jour par un employé de ses tokens FCM et préférences de rappel
    function isValidUserSelfUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let nextData = request.resource.data;
      return affected.hasOnly(['fcmTokens', 'fcmUpdatedAt', 'reminderWindowStart', 'reminderWindowEnd'])
        && (!affected.hasAny(['fcmTokens'])
            || ('fcmTokens' in nextData
                && nextData.fcmTokens is list
                && nextData.fcmTokens.size() <= 20
                && nextData.fcmTokens.join(',').size() <= 16384))
        && (!('fcmUpdatedAt' in nextData)
            || (nextData.fcmUpdatedAt is int && nextData.fcmUpdatedAt >= 0))
        && (!affected.hasAny(['reminderWindowStart'])
            || isValidOptionalNullableString(nextData, 'reminderWindowStart', 10))
        && (!affected.hasAny(['reminderWindowEnd'])
            || isValidOptionalNullableString(nextData, 'reminderWindowEnd', 10));
    }

    // Validation de mise à jour d'une commande par la closeuse assignée
    function isValidCloseuseOrderUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let nextData = request.resource.data;
      return affected.hasOnly([
          'statutCloseuse',
          'callInProgress',
          'livreurId',
          'statutLivreur',
          'reminderAt',
          'rejectionReason',
          'fieldNote',
          'rescheduleReason'
        ])
        && (!affected.hasAny(['statutCloseuse'])
            || ('statutCloseuse' in nextData
                && nextData.statutCloseuse in [
                  'nouveau',
                  'programme',
                  'en_cours',
                  'rejete',
                  'injoignable',
                  'indisponible'
                ]))
        // La closeuse peut laisser statutLivreur inchangé (ex. 'injoignable' posé par le livreur)
        // ou le réinitialiser à null / 'recu', et NE PEUT JAMAIS le changer en 'livre' ou 'en_route'.
        && (!affected.hasAny(['statutLivreur'])
            || ('statutLivreur' in nextData
                && (nextData.statutLivreur == null || nextData.statutLivreur == 'recu')))
        && isValidOptionalNullableString(nextData, 'rejectionReason', 1000)
        && isValidOptionalNullableString(nextData, 'fieldNote', 1000)
        && isValidOptionalNullableString(nextData, 'rescheduleReason', 1000)
        && (!('livreurId' in nextData)
            || nextData.livreurId == null
            || (nextData.livreurId is string && nextData.livreurId.size() <= 128))
        && (!affected.hasAny(['reminderAt'])
            || !('reminderAt' in nextData)
            || nextData.reminderAt == null
            || (nextData.reminderAt is number && nextData.reminderAt >= 0))
        && (!affected.hasAny(['callInProgress'])
            || !('callInProgress' in nextData)
            || nextData.callInProgress == null
            || (nextData.callInProgress is map
                && nextData.callInProgress.keys().hasAll(['active', 'by', 'startedAt'])
                && nextData.callInProgress.keys().hasOnly(['active', 'by', 'startedAt'])
                && nextData.callInProgress.active is bool
                && nextData.callInProgress.by is string
                && nextData.callInProgress.by == auth_().uid
                && nextData.callInProgress.startedAt is number
                && nextData.callInProgress.startedAt >= 0));
    }

    // Validation de mise à jour d'une commande par le livreur assigné
    function isValidLivreurOrderUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let nextData = request.resource.data;
      return affected.hasOnly([
          'statutLivreur',
          'rejectionReason',
          'deliveryFailureReason',
          'deliveryFieldNote'
        ])
        && 'statutLivreur' in nextData
        && nextData.statutLivreur in ['recu', 'en_route', 'livre', 'injoignable']
        && isValidOptionalNullableString(nextData, 'rejectionReason', 1000)
        && isValidOptionalNullableString(nextData, 'deliveryFailureReason', 1000)
        && isValidOptionalNullableString(nextData, 'deliveryFieldNote', 1000);
    }

    // Table de correspondance email Google → workspace possédé — jamais
    // lisible/écrivable côté client, uniquement via authenticateAdminGoogle
    // (Admin SDK). Chaque admin ne voit que SON propre espace (isolation
    // multi-tenant garantie par le custom claim workspaceId ci-dessous).
    match /adminsByEmail/{email} {
      allow read, write: if false;
    }

    match /workspaces/{workspaceId} {
      allow read: if isWorkspace(workspaceId);
      allow write: if isAdmin(workspaceId);

      match /teams/{teamId} {
        allow read: if isWorkspace(workspaceId);
        allow write: if isAdmin(workspaceId);

        // Secrets d'équipe (Meta CAPI tokens, etc.) : réservé strictement aux admins
        match /secrets/{secretId} {
          allow read, write: if isAdmin(workspaceId);
        }

        // Stats journalieres : lecture admin uniquement, ecriture par
        // Cloud Functions (Admin SDK) seulement.
        match /dailyStats/{dateKey} {
          allow read: if isAdmin(workspaceId);
          allow write: if false;
        }
      }

      match /users/{userId} {
        allow read: if isWorkspace(workspaceId);
        allow write: if isAdmin(workspaceId);
        // un employé peut mettre à jour SON propre token FCM (+ horodatage fcmUpdatedAt)
        // et SES préférences de rappel, rien d'autre
        allow update: if isWorkspace(workspaceId)
          && isOwner(userId)
          && isValidUserSelfUpdate();
      }

      match /accessLinks/{linkId} {
        // jamais accessible côté client — uniquement via Cloud Functions
        // (Admin SDK, qui contourne les règles) : section 10
        allow read, write: if false;
      }

      match /accessLinkSecrets/{linkId} {
        // jamais accessible côté client — uniquement via Cloud Functions
        // (Admin SDK, qui contourne les règles)
        allow read, write: if false;
      }

      match /notifications/{notifId} {
        allow read: if isAdmin(workspaceId)
          || (isWorkspace(workspaceId) && resource.data.userId == auth_().uid);
        allow create: if isAdmin(workspaceId);
        // L'admin ou l'employé destinataire peut marquer comme lu
        allow update: if (isAdmin(workspaceId) || (isWorkspace(workspaceId) && resource.data.userId == auth_().uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAdmin(workspaceId)
          || (isWorkspace(workspaceId) && resource.data.userId == auth_().uid);
      }

      match /remunerations/{userId} {
        allow read: if isAdmin(workspaceId) || (isWorkspace(workspaceId) && auth_().uid == userId);
        allow write: if false; // écrit uniquement par Cloud Function
      }

      // Insights COD par pays : lecture admin uniquement, écriture exclusive
      // par Cloud Functions (Admin SDK).
      match /codInsights/{countryCode} {
        allow read: if isAdmin(workspaceId);
        allow write: if false;
      }

      match /orders/{orderId} {
        // Admin voit tout le workspace ; Closeuse voit toutes les commandes de son équipe ;
        // Livreur ne voit QUE les commandes qui lui sont directement assignées (protection PII).
        allow read: if isAdmin(workspaceId)
          || (isCloseuse(workspaceId) && isSameTeam(resource.data.teamId))
          || (isLivreur(workspaceId) && isSameTeam(resource.data.teamId) && resource.data.livreurId == auth_().uid);

        allow create: if isAdmin(workspaceId); // créées par la sync Sheet→Firestore ou Cloud Functions

        // Closeuse : statutCloseuse + callInProgress + livreurId/statutLivreur + reminderAt + motifs/notes.
        // SÉCURITÉ : La closeuse ne peut assigner que le statut initial 'recu' (ou null) pour statutLivreur,
        // ou le laisser inchangé (ex. 'injoignable'). Elle NE PEUT PAS marquer 'livre' ni 'en_route'.
        allow update: if isCloseuse(workspaceId)
          && isSameTeam(resource.data.teamId)
          && resource.data.closeuseId == auth_().uid
          && isValidCloseuseOrderUpdate();

        // Livreur : uniquement statutLivreur, motifs et note terrain sur ses propres commandes
        allow update: if isLivreur(workspaceId)
          && isSameTeam(resource.data.teamId)
          && resource.data.livreurId == auth_().uid
          && isValidLivreurOrderUpdate();

        // Admin : accès complet, y compris statutAdminOverride
        allow update, delete: if isAdmin(workspaceId);
      }

      // Connexions aux boutiques Shopify (réservé strictement aux admins du workspace)
      match /shopifyConnections/{connectionId} {
        allow read, write: if isAdmin(workspaceId);
      }

      // Commandes Shopify non routées (réservé strictement aux admins du workspace)
      match /shopifyUnroutedOrders/{unroutedId} {
        allow read, write: if isAdmin(workspaceId);
      }

      // Sessions de tracking (fbp, fbc, UTM, IP, UA)
      // Gérées exclusivement côté serveur via Cloud Functions (Admin SDK)
      match /trackingSessions/{sessionId} {
        allow read, write: if false;
      }

      // Historique des échanges avec l'analyste IA (accessible par les admins du workspace)
      match /aiAssistantChats/{chatId} {
        allow read, write: if isAdmin(workspaceId);
      }

      // Versements de caisse fin de journée et retenues/imprévus livreurs
      match /cashSettlements/{settlementId} {
        allow read, write: if isAdmin(workspaceId);
      }

      // Sessions temporaires de pont OAuth Meta (Incognito / navigateur externe)
      match /metaOAuthSessions/{sessionId} {
        allow read, write: if isAdmin(workspaceId);
      }
    }
  }
}
